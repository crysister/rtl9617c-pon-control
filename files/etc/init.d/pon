#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
START=25
respawn_threshold=3600
respawn_timeout=5
respawn_retry=3
default_llid_count=1

USE_PROCD=1

pon_event() {
	[ -x /usr/sbin/pon-status ] || return 0
	/usr/sbin/pon-status --event "$1" "$2" >/dev/null 2>&1
}

enable_datapath() {
	local stage

	for stage in mac puc pdc; do
		pon_stage=$stage
		printf '1\n' > "$device/$stage" || return $?
	done
}

start_service() {
	pon_stage=device
	configure_link 2>/var/run/pon-service-error
	local result=$?
	printf 'stage=%s error=%s\n' "$pon_stage" "$result" >> /var/run/pon-service
	pon_event "pon_service" "stage=$pon_stage error=$result"
	if [ "$result" != 0 ]; then
		logger -t pon "Initialization failed at $pon_stage (exit $result)"
	fi
	if [ -s /var/run/pon-service-error ]; then
		logger -t pon < /var/run/pon-service-error
		cat /var/run/pon-service-error >&2
	fi
	return "$result"
}

configure_link() {
	local enabled mode onu_mac serial llids i
	local device=/sys/bus/platform/devices/4f5500000.pon

	[ -w "$device/serdes" ] || { logger -t pon "PON device unavailable"; return 1; }
	config_load pon
	config_get_bool enabled pon enabled 1
	printf 'enabled=%s error=0\n' "$enabled" > /var/run/pon-service
	[ "$enabled" = 1 ] || return 0
	pon_stage=mode
	config_get mode pon mode
	[ -n "$mode" ] || mode=$(sed -n 's/^mode=\([^ ]*\).*/\1/p' "$device/serdes")
	[ -n "$mode" ] || return 1
	pon_stage=bosa
	if ! printf '1\n' > "$device/bosa"; then
		logger -t pon "BOSA calibration unavailable; continuing without it"
	fi
	pon_stage=serdes
	printf '%s\n' "$mode" > "$device/serdes" || return $?
	pon_stage=onu_mac
	config_get onu_mac pon onu_mac
	[ -n "$onu_mac" ] || onu_mac=$(cat "$device/factory_onu_mac")
	if [ -z "$onu_mac" ]; then
		logger -t pon "ONU MAC unavailable"
		return 1
	fi
	printf '%s\n' "$onu_mac" > "$device/onu_mac" || return $?
	if [ "$mode" = gpon ] || [ "$mode" = xgpon ] || [ "$mode" = xgspon ]; then
		pon_stage=identity
		config_get serial pon serial_number
		[ -n "$serial" ] || serial=$(cat "$device/factory_serial_number")
		[ -n "$serial" ] || return 1
		if [ "$mode" = gpon ]; then
			/usr/sbin/pon-identity "$device/gpon_identity" "$serial" "$mode" || return $?
		else
			/usr/sbin/pon-identity "$device/xgpon_identity" "$serial" "$mode" || return $?
		fi
		pon_stage=datapath
		enable_datapath || return $?
		pon_stage=omci_interface
		ip link set pon-omci up || return $?
		pon_stage=data_interface
		ip link set pon0 up || logger -t pon "pon0 not up yet (no carrier)"
		pon_stage=activation
		printf '1\n' > "$device/activation" || return $?
		pon_stage=omci_daemon
		procd_open_instance omci
		procd_set_param command /usr/sbin/pon-omcid
		procd_set_param file /etc/config/pon
		procd_set_param respawn "$respawn_threshold" "$respawn_timeout" "$respawn_retry"
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
		return 0
	fi
	pon_stage=llid_count
	config_get llids pon llid_count "$default_llid_count"
	printf '%s\n' "$llids" > "$device/llid_count" || return $?
	pon_stage=datapath
	enable_datapath || return $?
	pon_stage=epon_interfaces
	i=0
	while [ "$i" -lt "$llids" ]; do
		printf '1\n' > "/proc/sys/net/ipv6/conf/pon-oam$i/disable_ipv6"
		ip link set "pon-oam$i" up || return $?
		ip link set "pon$i" up || logger -t pon "pon$i not up yet (no carrier)"
		i=$((i + 1))
	done
	pon_stage=traffic
	printf '1\n' > "$device/traffic" || return $?
	pon_stage=mpcp
	printf '1\n' > "$device/mpcp" || return $?
	pon_stage=oam_daemon
	i=0
	while [ "$i" -lt "$llids" ]; do
		procd_open_instance "oam-$i"
		procd_set_param command /usr/sbin/pon-oamd --interface "pon-oam$i" --llid-index "$i"
		procd_set_param file /etc/config/pon
		procd_set_param respawn "$respawn_threshold" "$respawn_timeout" "$respawn_retry"
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
		i=$((i + 1))
	done
	return 0
}

stop_service() {
	local device=/sys/bus/platform/devices/4f5500000.pon
	local interface mode rest result=0

	[ -r "$device/serdes" ] || return 0
	read -r mode rest < "$device/serdes"
	case "$mode" in
	mode=gpon|mode=xgpon|mode=xgspon)
		printf '0\n' > "$device/activation" || result=$?
		ip link set pon-omci down || result=$?
		;;
	mode=epon|mode=epon-d10g|mode=epon-bi10g)
		printf '0\n' > "$device/traffic" || result=$?
		printf '0\n' > "$device/mpcp" || result=$?
		for interface in /sys/class/net/pon-oam*; do
			if [ -d "$interface" ]; then
				ip link set "$(basename "$interface")" down || result=$?
			fi
		done
		;;
	esac
	for interface in /sys/class/net/pon[0-9]*; do
		if [ -d "$interface" ]; then
			ip link set "$(basename "$interface")" down || result=$?
		fi
	done
	printf 'enabled=0 stage=stop error=%s\n' "$result" > /var/run/pon-service
	return "$result"
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_open_trigger
	procd_add_reload_trigger pon
	procd_close_trigger
}
